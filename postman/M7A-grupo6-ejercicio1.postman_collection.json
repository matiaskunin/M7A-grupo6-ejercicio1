    {
      "name": "Pipeline config",
      "item": [
        {
          "name": "GET /pipeline/config",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/pipeline/config", "host": ["{{baseUrl}}"], "path": ["pipeline", "config"] },
            "description": "Devuelve el PipelineConfig completo: los 8 filtros con su `enabled` y sus `params`, mas la tabla de tasas de fallback."
          },
          "response": [
            {
              "name": "200 OK (recortado)",
              "originalRequest": {
                "method": "GET",
                "url": { "raw": "{{baseUrl}}/pipeline/config", "host": ["{{baseUrl}}"], "path": ["pipeline", "config"] }
              },
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n    \"filters\": {\n        \"passengerValidation\": {\n            \"enabled\": true,\n            \"params\": { \"thresholds\": { \"childMaxAge\": 12, \"seniorMinAge\": 65 } }\n        },\n        \"flightValidation\": { \"enabled\": true, \"params\": {} },\n        \"exchangeRateEnrichment\": {\n            \"enabled\": true,\n            \"params\": {\n                \"timeoutMs\": 5000,\n                \"maxRetries\": 3,\n                \"cacheTtlMs\": 3600000,\n                \"baseCurrency\": \"USD\"\n            }\n        },\n        \"basePriceCalculation\": {\n            \"enabled\": true,\n            \"params\": { \"multipliers\": { \"economy\": 1, \"business\": 2.5, \"first\": 4 } }\n        },\n        \"loyaltyDiscount\": {\n            \"enabled\": true,\n            \"params\": { \"rates\": { \"bronze\": 0.05, \"silver\": 0.1, \"gold\": 0.15 } }\n        },\n        \"passengerTypeAdjustment\": {\n            \"enabled\": true,\n            \"params\": { \"rates\": { \"child\": 0.25, \"senior\": 0.15, \"adult\": 0 } }\n        },\n        \"taxAndFees\": {\n            \"enabled\": true,\n            \"params\": { \"taxRate\": 0.12, \"airportFee\": 25, \"fuelSurchargeRate\": 0.08 }\n        },\n        \"currencyConversion\": { \"enabled\": true, \"params\": {} }\n    },\n    \"exchangeRateFallback\": {\n        \"USD\": 1,\n        \"ARS\": 1000,\n        \"BRL\": 5.4,\n        \"EUR\": 0.92\n    }\n}"
            }
